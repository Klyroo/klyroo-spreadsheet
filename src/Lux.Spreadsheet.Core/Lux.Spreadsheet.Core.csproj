<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blux.UI.Tools</RootNamespace>
    <PackageId>Lux.Spreadsheet.Core</PackageId>
    <Description>LuxStack Spreadsheet Core: Headless spreadsheet import engine with layout detection, 80%-pass column suggestions, unknown value resolution, row validation and batched submit. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
