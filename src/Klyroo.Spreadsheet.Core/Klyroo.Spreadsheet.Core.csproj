<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Spreadsheet</RootNamespace>
    <PackageId>Klyroo.Spreadsheet.Core</PackageId>
    <Description>Klyroo Spreadsheet Core: Headless spreadsheet import engine with layout detection, 80%-pass column suggestions, unknown value resolution, row validation and batched submit. Zero UI dependency, NativeAOT compatible.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
