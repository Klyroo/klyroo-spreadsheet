@namespace Klyroo.Spreadsheet
@using Microsoft.AspNetCore.Components.Forms
@inherits KlyComponentBase
@implements IDisposable

@if (Importer is not null)
{
    var steps = Importer.GetSteps();
    var currentStep = steps.FirstOrDefault(s => s.Key == Importer.CurrentStepKey) ?? steps[0];

    <div class="@RootClass" data-slot="spreadsheet-import" data-step="@currentStep.Key" @attributes="AdditionalAttributes">
        @* Wizard Header *@
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-(--klyroo-border) pb-3" data-slot="spreadsheet-header">
            <div class="flex items-center gap-2.5">
                <h2 class="m-0 text-base font-bold text-(--klyroo-text-highlighted)" data-slot="spreadsheet-title">@Title</h2>
                @if (Importer.FileLoaded && !string.IsNullOrEmpty(Importer.FileName))
                {
                    <span class="rounded-full bg-(--klyroo-bg-muted) px-2.5 py-0.5 text-xs font-medium text-(--klyroo-text-muted)"
                          data-slot="spreadsheet-file-pill">@Importer.FileName</span>
                }
            </div>

            @if (Wizard)
            {
                <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0" data-slot="spreadsheet-stepper">
                    @foreach (var step in steps)
                    {
                        var isCurrent = step.State == "current";
                        var isDone = step.State == "done";
                        var isSkipped = step.State == "skipped";
                        var isEarlier = step.Position < currentStep.Position;
                        <li>
                            <button type="button"
                                    disabled="@(!(isDone || (isSkipped && isEarlier)))"
                                    aria-current="@(isCurrent ? "step" : null)"
                                    class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold @(isCurrent ? "bg-(--klyroo-primary) text-(--klyroo-primary-contrast)" : isDone ? "bg-(--klyroo-success)/15 text-(--klyroo-success-text) hover:opacity-90" : "bg-(--klyroo-bg-muted) text-(--klyroo-text-muted)") disabled:cursor-default"
                                    data-slot="spreadsheet-step-item"
                                    data-key="@step.Key"
                                    data-state="@step.State"
                                    @onclick="@(() => Importer.GoToStep(step.Key))">
                                <span class="tabular-nums">@(isDone || isSkipped ? "✓" : $"{step.Position}.")</span>
                                <span>@step.Label</span>
                                @if (isSkipped)
                                {
                                    <span class="text-[10px] opacity-75">(nothing to do)</span>
                                }
                            </button>
                        </li>
                    }
                </ol>
            }
        </header>

        @* Active Step Content *@
        <div class="flex flex-col gap-4" data-slot="spreadsheet-body" data-spreadsheet-step="@currentStep.Key">
            @switch (currentStep.Key)
            {
                case "file":
                    @RenderFileStep()
                    break;
                case "columns":
                    @RenderColumnsStep()
                    break;
                case "values":
                    @RenderValuesStep()
                    break;
                case "review":
                    @RenderReviewStep()
                    break;
                case "submit":
                    @RenderSubmitStep()
                    break;
            }
        </div>

        @* Wizard Navigation Footer *@
        @if (Wizard)
        {
            <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-(--klyroo-border) pt-3" data-slot="spreadsheet-nav">
                <div class="flex items-center gap-2">
                    @if (Importer.CanPreviousStep)
                    {
                        <button type="button"
                                class="inline-flex h-9 items-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3.5 text-xs font-semibold text-(--klyroo-text) hover:bg-(--klyroo-bg-muted)"
                                data-slot="spreadsheet-nav-back"
                                @onclick="@(() => Importer.PreviousStep())">
                            Back
                        </button>
                    }
                </div>

                <div class="flex items-center gap-3">
                    @if (currentStep.Key == "file" && !Importer.FileLoaded)
                    {
                        <span class="text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-nav-hint">Choose a file to continue</span>
                    }
                    else if (currentStep.Key == "columns" && Importer.MissingFields.Count > 0)
                    {
                        <span class="text-xs font-medium text-(--klyroo-error-text)" data-slot="spreadsheet-nav-hint">
                            Required columns missing: @Importer.MissingFields.Count
                        </span>
                    }
                    else if (currentStep.Key == "values" && Importer.OpenQuestions.Count > 0)
                    {
                        <span class="text-xs font-medium text-(--klyroo-error-text)" data-slot="spreadsheet-nav-hint">
                            Values to choose: @Importer.OpenQuestions.Count
                        </span>
                    }
                    else if (currentStep.Key == "review" && Importer.InvalidRows.Count > 0)
                    {
                        <span class="text-xs text-(--klyroo-warning-text)" data-slot="spreadsheet-nav-hint">
                            Rows with errors are left out: @Importer.InvalidRows.Count
                        </span>
                    }

                    @if (currentStep.Key != "submit")
                    {
                        <button type="button"
                                disabled="@(!Importer.CanNextStep)"
                                class="inline-flex h-9 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-4 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90 disabled:opacity-40"
                                data-slot="spreadsheet-nav-continue"
                                @onclick="@(() => Importer.NextStep())">
                            Continue
                        </button>
                    }
                    else if (Importer.SubmitStatus != SpreadsheetSubmitStatus.Done)
                    {
                        <button type="button"
                                disabled="@(!Importer.CanSubmit || Importer.SubmitStatus == SpreadsheetSubmitStatus.Running)"
                                class="inline-flex h-9 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-4 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90 disabled:opacity-40"
                                data-slot="spreadsheet-submit-button"
                                @onclick="Importer.SubmitAsync">
                            @($"Import {Importer.ImportableRows.Count} rows")
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="inline-flex h-9 items-center rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3.5 text-xs font-semibold text-(--klyroo-text) hover:bg-(--klyroo-bg-muted)"
                                data-slot="spreadsheet-import-another"
                                @onclick="Importer.ClearFile">
                            Import another file
                        </button>
                    }
                </div>
            </footer>
        }
    </div>
}

@code {
    private SpreadsheetImporter? _subscribed;
    private (int RowIndex, string FieldKey)? _editingCell;
    private string _editingText = "";
    private string _pastedText = "";
    private string? _fileError;
    private bool _loadingFile;

    /// <summary>The importer that holds the import state. The component renders it and calls its methods. Users load a file by choosing or dropping it on the file step (CSV, TSV, text or <c>.xlsx</c>, through <see cref="SpreadsheetImporter.LoadFileAsync"/>) or by pasting rows; your code can also call <see cref="SpreadsheetImporter.LoadText"/> or <see cref="SpreadsheetImporter.LoadWorkbook"/>.</summary>
    [Parameter] public required SpreadsheetImporter Importer { get; set; }
    /// <summary>The heading shown above the wizard. Defaults to <c>Import</c>.</summary>
    [Parameter] public string Title { get; set; } = "Import";
    /// <summary>The largest file users can choose, in bytes. Defaults to 10 MB.</summary>
    [Parameter] public long MaxFileSize { get; set; } = 10 * 1024 * 1024;
    /// <summary>Shows the step bar and the Back, Continue and Import buttons. When <see langword="false"/> only the current step is rendered and your code moves between steps with the importer's step methods.</summary>
    [Parameter] public bool Wizard { get; set; } = true;

    private string RootClass =>
        $"flex w-full flex-col gap-4 rounded-(--klyroo-radius-md) border border-(--klyroo-border) bg-(--klyroo-bg) p-4 text-sm text-(--klyroo-text) {Class}".Trim();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Importer))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnImporterChanged;
            _subscribed = Importer;
            if (_subscribed is not null) _subscribed.Changed += OnImporterChanged;
        }
    }

    private void OnImporterChanged() => _ = InvokeAsync(StateHasChanged);

    private RenderFragment RenderFileStep() =>
        @<div class="flex flex-col gap-4" data-slot="spreadsheet-step-file">
            @if (!Importer.FileLoaded)
            {
                <label class="relative flex cursor-pointer flex-col items-center justify-center gap-2 rounded-(--klyroo-radius-md) border-2 border-dashed border-(--klyroo-border-accented) bg-(--klyroo-bg-muted)/50 p-6 text-center focus-within:outline-2 focus-within:outline-(--klyroo-primary) hover:bg-(--klyroo-bg-muted)"
                       data-slot="spreadsheet-dropzone">
                    @* The file input covers the zone, so a file dropped anywhere on it is received by the input. *@
                    <InputFile class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
                               accept="@string.Join(",", Importer.Schema.Accept)"
                               aria-label="Choose a file to import"
                               data-slot="spreadsheet-file-input"
                               OnChange="OnFileSelectedAsync" />
                    <span class="m-0 font-semibold text-(--klyroo-text-highlighted)">@(_loadingFile ? "Reading the file…" : "Drop your file here or click to choose one")</span>
                    <span class="m-0 text-xs text-(--klyroo-text-muted)">
                        @string.Join(", ", Importer.Schema.Accept)
                        @(Importer.Schema.MaxRows is { } mr ? $" · up to {mr} rows" : "")
                    </span>
                </label>

                @if (_fileError is not null)
                {
                    <p class="m-0 rounded-(--klyroo-radius) bg-(--klyroo-error)/10 px-3 py-2 text-xs text-(--klyroo-error-text)" role="alert" data-slot="spreadsheet-file-error">@_fileError</p>
                }

                <details class="rounded-(--klyroo-radius) border border-(--klyroo-border) p-3" data-slot="spreadsheet-paste">
                    <summary class="cursor-pointer text-xs font-semibold text-(--klyroo-text-highlighted)">Or paste rows copied from a spreadsheet</summary>
                    <div class="mt-2 flex flex-col gap-2">
                        <textarea rows="5"
                                  aria-label="Rows to import"
                                  placeholder="Paste the rows here, header row first"
                                  class="w-full rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) p-2 font-mono text-xs"
                                  data-slot="spreadsheet-paste-input"
                                  @bind="_pastedText" @bind:event="oninput"></textarea>
                        <div>
                            <button type="button"
                                    disabled="@string.IsNullOrWhiteSpace(_pastedText)"
                                    class="inline-flex h-8 items-center rounded-(--klyroo-radius) bg-(--klyroo-primary) px-3 text-xs font-semibold text-(--klyroo-primary-contrast) hover:opacity-90 disabled:opacity-40"
                                    data-slot="spreadsheet-paste-load"
                                    @onclick="LoadPastedRows">
                                Use these rows
                            </button>
                        </div>
                    </div>
                </details>

                <div class="flex flex-col gap-1.5" data-slot="spreadsheet-expected-columns">
                    <span class="text-xs font-semibold text-(--klyroo-text-muted)">Expected columns:</span>
                    @foreach (var group in Importer.Schema.Columns.Where(c => string.IsNullOrEmpty(c.From)).GroupBy(c => c.Group ?? ""))
                    {
                        <div class="flex flex-wrap items-center gap-1.5" data-slot="spreadsheet-expected-group" data-group="@(group.Key.Length > 0 ? group.Key : null)">
                            @if (group.Key.Length > 0)
                            {
                                <span class="text-[11px] font-semibold uppercase tracking-wide text-(--klyroo-text-muted)">@group.Key</span>
                            }
                            @foreach (var col in group)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full border border-(--klyroo-border) bg-(--klyroo-bg-muted) px-2.5 py-0.5 text-xs font-medium text-(--klyroo-text-highlighted)"
                                      title="@col.Description"
                                      data-slot="spreadsheet-expected-pill">
                                    <span>@col.EffectiveLabel</span>
                                    @if (col.Required)
                                    {
                                        <span class="text-(--klyroo-error-text)">*</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-(--klyroo-text-muted)">optional</span>
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) p-3"
                     data-slot="spreadsheet-file-card">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 min-w-10 items-center justify-center rounded-(--klyroo-radius) bg-(--klyroo-bg) px-2 text-xs font-bold uppercase text-(--klyroo-text-highlighted)">
                            @(Path.GetExtension(Importer.FileName)?.TrimStart('.').ToUpperInvariant() is { Length: > 0 } ext ? ext : "CSV")
                        </span>
                        <div class="flex flex-col">
                            <span class="font-semibold text-(--klyroo-text-highlighted)" data-slot="spreadsheet-file-name">@Importer.FileName</span>
                            <span class="text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-file-summary">
                                @($"{Importer.AllRows.Count} rows · {Importer.Sheets.Count} sheets · Column names on row {Importer.HeaderRowNumber}")
                            </span>
                        </div>
                    </div>
                    <button type="button"
                            class="rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-3 py-1 text-xs font-medium text-(--klyroo-text) hover:bg-(--klyroo-bg-elevated)"
                            data-slot="spreadsheet-file-replace"
                            @onclick="ReplaceFile">
                        Replace
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-xs" data-slot="spreadsheet-layout">
                    @if (Importer.Sheets.Count > 1)
                    {
                        <label class="flex items-center gap-2">
                            <span class="font-semibold text-(--klyroo-text-muted)">Sheet</span>
                            <select class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2.5 text-xs"
                                    data-slot="spreadsheet-sheet-select"
                                    @onchange="@(e => Importer.SetSheet(e.Value?.ToString() ?? ""))">
                                @foreach (var sheet in Importer.Sheets)
                                {
                                    <option value="@sheet.Name" selected="@(sheet.Name == Importer.CurrentSheet?.Name)">@sheet.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (Importer.CurrentSheet is { Rows.Count: > 1 } current)
                    {
                        <label class="flex items-center gap-2">
                            <span class="font-semibold text-(--klyroo-text-muted)">Column names on row</span>
                            <select class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2.5 text-xs"
                                    data-slot="spreadsheet-header-row-select"
                                    @onchange="OnHeaderRowChange">
                                @for (var i = 0; i < Math.Min(current.Rows.Count, SpreadsheetImporter.HeaderScanRows); i++)
                                {
                                    <option value="@i" selected="@(i == Importer.HeaderRowIndex)">@current.RowNumbers[i]</option>
                                }
                            </select>
                        </label>
                    }
                </div>
            }
        </div>;

    private RenderFragment RenderColumnsStep() =>
        @<div class="flex flex-col gap-3" data-slot="spreadsheet-column-mapping">
            @foreach (var f in Importer.Fields.Where(f => string.IsNullOrEmpty(f.Column.From)))
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) p-3"
                     data-slot="spreadsheet-column-row" data-field="@f.Column.Key" data-status="@f.Status.ToString().ToLowerInvariant()">
                    <div class="flex flex-col gap-0.5">
                        <span class="text-xs font-semibold text-(--klyroo-text-highlighted)">
                            @f.Column.EffectiveLabel
                            @if (f.Column.Required)
                            {
                                <span class="ms-0.5 text-(--klyroo-error-text)">*</span>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(f.Column.Description))
                        {
                            <span class="text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-column-description">@f.Column.Description</span>
                        }
                        @if (f.Suggestion is { } sug)
                        {
                            <div class="flex items-center gap-1.5 text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-column-suggestion">
                                <span>"@sug.HeaderText" has values like @string.Join(", ", sug.Samples)</span>
                                <button type="button"
                                        class="font-semibold text-(--klyroo-primary-text) hover:underline"
                                        data-slot="spreadsheet-use-suggestion"
                                        @onclick="@(() => Importer.AssignColumn(f.Column.Key, sug.HeaderIndex))">
                                    Use it
                                </button>
                            </div>
                        }
                        else if (f.Samples.Count > 0)
                        {
                            <span class="text-xs text-(--klyroo-text-muted)">Samples: @string.Join(", ", f.Samples)</span>
                        }
                    </div>

                    <div class="flex items-center gap-2">
                        <select aria-label="@($"Column for {f.Column.EffectiveLabel}")"
                                class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2.5 text-xs"
                                value="@(f.HeaderIndex?.ToString() ?? "")"
                                data-slot="spreadsheet-column-select"
                                @onchange="@(e => OnColumnSelectChange(f.Column.Key, e.Value?.ToString()))">
                            <option value="">Not in the file</option>
                            @for (var h = 0; h < Importer.Headers.Count; h++)
                            {
                                if (string.IsNullOrWhiteSpace(Importer.Headers[h])) continue;
                                <option value="@h" selected="@(f.HeaderIndex == h)">@Importer.Headers[h]</option>
                            }
                        </select>
                        @if (f.AssignedBy == "user")
                        {
                            <button type="button"
                                    class="text-xs font-medium text-(--klyroo-primary-text) hover:underline"
                                    data-slot="spreadsheet-column-undo"
                                    @onclick="@(() => Importer.ResetColumn(f.Column.Key))">
                                Undo
                            </button>
                        }
                    </div>
                </div>
            }

            @if (Importer.UnusedHeaders.Count > 0)
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-unused-headers">
                    Not imported: @string.Join(", ", Importer.UnusedHeaders)
                </p>
            }
        </div>;

    private RenderFragment RenderValuesStep() =>
        @<div class="flex flex-col gap-3" data-slot="spreadsheet-value-mapping">
            @if (Importer.Questions.Count == 0)
            {
                <p class="m-0 text-xs text-(--klyroo-text-muted)" data-slot="spreadsheet-values-empty">Every value was found in the list</p>
            }
            else
            {
                @foreach (var q in Importer.Questions)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) p-3"
                         data-slot="spreadsheet-value-row" data-field="@q.FieldKey" data-value="@q.RawValue" data-state="@(q.IsOpen ? "open" : "answered")">
                        <div class="flex flex-col gap-0.5">
                            <span class="text-xs font-semibold text-(--klyroo-text-highlighted)">@q.FieldLabel: "@q.RawValue"</span>
                            <span class="text-[11px] text-(--klyroo-text-muted)">@($"{q.RowIndexes.Count} rows")</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <select aria-label="@($"Answer for {q.RawValue}")"
                                    class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2.5 text-xs"
                                    data-slot="spreadsheet-value-select"
                                    @onchange="@(e => OnValueAnswerChange(q, e.Value?.ToString()))">
                                <option value="">Choose…</option>
                                @foreach (var opt in q.Choices)
                                {
                                    var isSelected = q.Answer?.Action == SpreadsheetValueAnswerAction.Map && q.Answer.MappedValue == opt.Value;
                                    <option value="@($"map:{opt.Value}")" selected="@isSelected">@opt.Label</option>
                                }
                                @if (q.CanCreate)
                                {
                                    <option value="action:create" selected="@(q.Answer?.Action == SpreadsheetValueAnswerAction.Create)">Create "@q.RawValue"</option>
                                }
                                <option value="action:leave-empty" selected="@(q.Answer?.Action == SpreadsheetValueAnswerAction.LeaveEmpty)">Leave empty</option>
                                <option value="action:skip-rows" selected="@(q.Answer?.Action == SpreadsheetValueAnswerAction.SkipRows)">Don't import these rows</option>
                            </select>
                        </div>
                    </div>
                }
            }
        </div>;

    private RenderFragment RenderReviewStep() =>
        @<div class="flex flex-col gap-3" data-slot="spreadsheet-review">
            @* Stats tiles *@
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3" data-slot="spreadsheet-stats">
                <div class="rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) p-3" data-slot="spreadsheet-stat-importable">
                    <span class="text-lg font-bold tabular-nums text-(--klyroo-success-text)">@Importer.ImportableRows.Count</span>
                    <span class="ms-1.5 text-xs text-(--klyroo-text-muted)">rows to import</span>
                </div>
                <div class="rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) p-3" data-slot="spreadsheet-stat-invalid">
                    <span class="text-lg font-bold tabular-nums @(Importer.InvalidRows.Count > 0 ? "text-(--klyroo-error-text)" : "text-(--klyroo-text-highlighted)")">@Importer.InvalidRows.Count</span>
                    <span class="ms-1.5 text-xs text-(--klyroo-text-muted)">rows with errors</span>
                </div>
                <div class="rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-muted) p-3" data-slot="spreadsheet-stat-discarded">
                    <span class="text-lg font-bold tabular-nums text-(--klyroo-text-highlighted)">@Importer.DiscardedRows.Count</span>
                    <span class="ms-1.5 text-xs text-(--klyroo-text-muted)">rows left out</span>
                </div>
            </div>

            @* Toolbar *@
            <div class="flex flex-wrap items-center justify-between gap-2" data-slot="spreadsheet-toolbar">
                <div class="flex items-center gap-1" role="tablist">
                    @foreach (var tab in Enum.GetValues<SpreadsheetReviewTab>())
                    {
                        var active = Importer.ReviewTab == tab;
                        var label = tab switch
                        {
                            SpreadsheetReviewTab.Importable => $"To import ({Importer.ImportableRows.Count})",
                            SpreadsheetReviewTab.Invalid => $"Invalid ({Importer.InvalidRows.Count})",
                            SpreadsheetReviewTab.Discarded => $"Left out ({Importer.DiscardedRows.Count})",
                            _ => $"All ({Importer.AllRows.Count})",
                        };
                        <button type="button" role="tab" aria-selected="@(active ? "true" : "false")"
                                class="rounded-(--klyroo-radius) px-2.5 py-1 text-xs font-semibold @(active ? "bg-(--klyroo-bg-muted) text-(--klyroo-text-highlighted)" : "text-(--klyroo-text-muted) hover:text-(--klyroo-text)")"
                                data-slot="spreadsheet-review-tab"
                                data-tab="@tab.ToString().ToLowerInvariant()"
                                @onclick="@(() => Importer.SetReviewTab(tab))">
                            @label
                        </button>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <select aria-label="Severity"
                            class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2 text-xs"
                            data-slot="spreadsheet-review-level"
                            @onchange="@(e => Importer.SetReviewLevel(Enum.Parse<SpreadsheetReviewLevel>(e.Value?.ToString() ?? nameof(SpreadsheetReviewLevel.All))))">
                        <option value="@SpreadsheetReviewLevel.All" selected="@(Importer.ReviewLevel == SpreadsheetReviewLevel.All)">All severities</option>
                        <option value="@SpreadsheetReviewLevel.Blocking" selected="@(Importer.ReviewLevel == SpreadsheetReviewLevel.Blocking)">Errors</option>
                        <option value="@SpreadsheetReviewLevel.Warnings" selected="@(Importer.ReviewLevel == SpreadsheetReviewLevel.Warnings)">Warnings</option>
                    </select>
                    @{ var issueKinds = IssueKinds(); }
                    @if (issueKinds.Count > 0)
                    {
                        <select aria-label="Issue"
                                class="h-8 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2 text-xs"
                                data-slot="spreadsheet-review-issue"
                                @onchange="@(e => Importer.SetReviewIssueFilter(e.Value?.ToString() ?? ""))">
                            <option value="" selected="@(Importer.ReviewIssueFilter.Length == 0)">All issues</option>
                            @foreach (var kind in issueKinds)
                            {
                                <option value="@kind.Filter" selected="@(Importer.ReviewIssueFilter == kind.Filter)">@($"{kind.Label} ({kind.Count})")</option>
                            }
                        </select>
                    }
                </div>

                <input type="search"
                       value="@Importer.ReviewSearch"
                       placeholder="Search rows…"
                       aria-label="Search rows"
                       class="h-8 w-48 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg) px-2.5 text-xs"
                       data-slot="spreadsheet-review-search"
                       @oninput="@(e => Importer.SetReviewSearch(e.Value?.ToString() ?? ""))" />
            </div>

            @if (Importer.SelectedRowIndexes.Count > 0)
            {
                <div class="flex flex-wrap items-center gap-3 rounded-(--klyroo-radius) bg-(--klyroo-bg-muted) px-3 py-2 text-xs" data-slot="spreadsheet-selection-bar">
                    <span class="font-semibold">@($"{Importer.SelectedRowIndexes.Count} selected")</span>
                    <button type="button" class="font-medium text-(--klyroo-error-text) hover:underline" data-slot="spreadsheet-discard-selected"
                            @onclick="@(() => { Importer.DiscardRows(Importer.SelectedRowIndexes.ToList()); Importer.ClearSelection(); })">Leave out</button>
                    <button type="button" class="font-medium text-(--klyroo-primary-text) hover:underline" data-slot="spreadsheet-restore-selected"
                            @onclick="@(() => { Importer.RestoreRows(Importer.SelectedRowIndexes.ToList()); Importer.ClearSelection(); })">Restore</button>
                    <button type="button" class="text-(--klyroo-text-muted) hover:underline" data-slot="spreadsheet-clear-selection"
                            @onclick="Importer.ClearSelection">Clear selection</button>
                </div>
            }

            @* Table + Optional Row Inspector *@
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
                <div class="@(Importer.InspectedRow is not null ? "lg:col-span-8" : "lg:col-span-12") overflow-x-auto rounded-(--klyroo-radius) border border-(--klyroo-border)"
                     data-slot="spreadsheet-table">
                    <table class="min-w-full text-xs">
                        <thead class="border-b border-(--klyroo-border) bg-(--klyroo-bg-muted) font-semibold text-(--klyroo-text-muted)">
                            <tr>
                                <th scope="col" class="w-8 px-2.5 py-2 text-start">
                                    <input type="checkbox" aria-label="Select the visible rows"
                                           checked="@(Importer.VisibleReviewRows.Count > 0 && Importer.VisibleReviewRows.All(r => Importer.SelectedRowIndexes.Contains(r.Index)))"
                                           data-slot="spreadsheet-select-all"
                                           @onchange="@(e => SelectVisibleRows(e.Value is true))" />
                                </th>
                                <th scope="col" class="w-16 px-2.5 py-2 text-start">Row</th>
                                <th scope="col" class="w-24 px-2.5 py-2 text-start">Status</th>
                                @foreach (var f in Importer.Fields)
                                {
                                    <th scope="col" class="px-3 py-2 text-start">@f.Column.EffectiveLabel</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-(--klyroo-border)">
                            @foreach (var row in Importer.VisibleReviewRows)
                            {
                                var isDiscarded = row.DiscardReason is not null;
                                <tr class="@(isDiscarded ? "line-through opacity-60" : "")"
                                    data-slot="spreadsheet-row"
                                    data-index="@row.Index"
                                    data-status="@row.Status.ToString().ToLowerInvariant()">
                                    <td class="px-2.5 py-1.5">
                                        <input type="checkbox" aria-label="@($"Select row {row.RowNumber}")"
                                               checked="@Importer.SelectedRowIndexes.Contains(row.Index)"
                                               data-slot="spreadsheet-row-select"
                                               @onchange="@(e => Importer.ToggleRowSelection(row.Index, e.Value is true))" />
                                    </td>
                                    <td class="px-2.5 py-1.5">
                                        <button type="button"
                                                class="font-mono font-semibold text-(--klyroo-primary-text) hover:underline"
                                                aria-label="@($"Inspect row {row.RowNumber}")"
                                                data-slot="spreadsheet-inspect-button"
                                                @onclick="@(() => Importer.InspectRow(row.Index))">
                                            #@row.RowNumber
                                        </button>
                                    </td>
                                    <td class="px-2.5 py-1.5">
                                        <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold @(row.Status == SpreadsheetRowStatus.Blocking ? "bg-(--klyroo-error)/15 text-(--klyroo-error-text)" : row.Status == SpreadsheetRowStatus.Warning ? "bg-(--klyroo-warning)/15 text-(--klyroo-warning-text)" : "bg-(--klyroo-success)/15 text-(--klyroo-success-text)")"
                                              data-slot="spreadsheet-row-status">
                                            @row.Status
                                        </span>
                                    </td>
                                    @foreach (var f in Importer.Fields)
                                    {
                                        row.Cells.TryGetValue(f.Column.Key, out var cell);
                                        var isEditing = _editingCell == (row.Index, f.Column.Key);
                                        <td class="px-3 py-1.5" data-slot="spreadsheet-cell" data-field="@f.Column.Key" data-edited="@(cell?.Edited == true ? "true" : null)">
                                            @if (isEditing)
                                            {
                                                <input type="text"
                                                       value="@_editingText"
                                                       aria-label="@($"Edit {f.Column.EffectiveLabel}")"
                                                       class="h-7 w-full rounded border border-(--klyroo-primary-text) bg-(--klyroo-bg) px-2 text-xs"
                                                       data-slot="spreadsheet-cell-editor"
                                                       @oninput="@(e => _editingText = e.Value?.ToString() ?? "")"
                                                       @onkeydown="@(e => OnCellEditorKeyDown(e, row.Index, f.Column.Key))"
                                                       @onblur="@(() => CommitCellEdit(row.Index, f.Column.Key))" />
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        disabled="@(isDiscarded || !f.Column.Editable)"
                                                        class="flex w-full items-center justify-between gap-1 text-start @(cell?.Issue is not null ? "text-(--klyroo-error-text) font-semibold" : "text-(--klyroo-text)")"
                                                        title="@cell?.Issue?.Message"
                                                        data-slot="spreadsheet-cell-trigger"
                                                        @onclick="@(() => StartCellEdit(row.Index, f.Column.Key, cell?.Text ?? ""))">
                                                    <span>@(string.IsNullOrEmpty(cell?.DisplayText) ? "empty" : cell.DisplayText)</span>
                                                    @if (cell?.Edited == true)
                                                    {
                                                        <span class="text-[10px] text-(--klyroo-primary-text)" title="@($"Original: {cell.OriginalText}")">✎</span>
                                                    }
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Importer.InspectedRow is { } inspected)
                {
                    <aside class="flex flex-col gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) bg-(--klyroo-bg-elevated) p-3.5 text-xs lg:col-span-4"
                           data-slot="spreadsheet-row-inspector">
                        <div class="flex items-center justify-between gap-2 border-b border-(--klyroo-border) pb-2">
                            <span class="font-bold text-(--klyroo-text-highlighted)">Row @inspected.RowNumber</span>
                            <div class="flex items-center gap-1">
                                <button type="button" class="rounded px-1.5 py-0.5 hover:bg-(--klyroo-bg-muted)"
                                        aria-label="Previous row with issues" data-slot="inspector-prev"
                                        @onclick="Importer.InspectPreviousIssueRow">‹</button>
                                <button type="button" class="rounded px-1.5 py-0.5 hover:bg-(--klyroo-bg-muted)"
                                        aria-label="Next row with issues" data-slot="inspector-next"
                                        @onclick="Importer.InspectNextIssueRow">›</button>
                                <button type="button" class="rounded px-1.5 py-0.5 hover:bg-(--klyroo-bg-muted)"
                                        aria-label="Close inspector" data-slot="inspector-close"
                                        @onclick="@(() => Importer.InspectRow(null))">✕</button>
                            </div>
                        </div>

                        @if (inspected.Issues.Count > 0)
                        {
                            <div class="flex flex-col gap-1.5" data-slot="inspector-issues">
                                @foreach (var issue in inspected.Issues)
                                {
                                    <div class="rounded bg-(--klyroo-error)/10 px-2.5 py-1.5 text-(--klyroo-error-text)" data-slot="inspector-issue">
                                        <strong>@(issue.Field ?? "Row"):</strong> @issue.Message
                                    </div>
                                }
                            </div>
                        }

                        @{ var editedCells = inspected.Cells.Where(c => c.Value.Edited).ToList(); }
                        @if (editedCells.Count > 0)
                        {
                            <div class="flex flex-col gap-1" data-slot="inspector-edits">
                                @foreach (var (fieldKey, cell) in editedCells)
                                {
                                    var label = Importer.Fields.FirstOrDefault(f => f.Column.Key == fieldKey)?.Column.EffectiveLabel ?? fieldKey;
                                    <div class="flex items-center justify-between gap-2">
                                        <span><strong>@label:</strong> @cell.OriginalText → @cell.Text</span>
                                        <button type="button" class="font-medium text-(--klyroo-primary-text) hover:underline"
                                                data-slot="inspector-revert"
                                                @onclick="@(() => Importer.RevertCell(inspected.Index, fieldKey))">Undo</button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="flex items-center justify-end gap-2 border-t border-(--klyroo-border) pt-2">
                            @if (inspected.DiscardReason == SpreadsheetDiscardReason.Manual)
                            {
                                <button type="button" class="font-medium text-(--klyroo-primary-text) hover:underline"
                                        data-slot="inspector-restore"
                                        @onclick="@(() => Importer.RestoreRows([inspected.Index]))">
                                    Restore this row
                                </button>
                            }
                            else if (inspected.DiscardReason is null)
                            {
                                <button type="button" class="font-medium text-(--klyroo-error-text) hover:underline"
                                        data-slot="inspector-discard"
                                        @onclick="@(() => Importer.DiscardRows([inspected.Index]))">
                                    Leave out this row
                                </button>
                            }
                        </div>
                    </aside>
                }
            </div>
        </div>;

    private RenderFragment RenderSubmitStep() =>
        @<div class="flex flex-col gap-4" data-slot="spreadsheet-submit-step">
            @if (Importer.SubmitStatus == SpreadsheetSubmitStatus.Idle)
            {
                <dl class="m-0 grid grid-cols-2 gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) p-4 text-xs sm:grid-cols-4" data-slot="spreadsheet-summary">
                    <div>
                        <dt class="text-(--klyroo-text-muted)">Rows to import</dt>
                        <dd class="m-0 text-base font-bold tabular-nums text-(--klyroo-text-highlighted)">@Importer.ImportableRows.Count</dd>
                    </div>
                    <div>
                        <dt class="text-(--klyroo-text-muted)">Invalid, not imported</dt>
                        <dd class="m-0 text-base font-bold tabular-nums text-(--klyroo-error-text)">@Importer.InvalidRows.Count</dd>
                    </div>
                    <div>
                        <dt class="text-(--klyroo-text-muted)">Left out</dt>
                        <dd class="m-0 text-base font-bold tabular-nums text-(--klyroo-text-muted)">@Importer.DiscardedRows.Count</dd>
                    </div>
                    <div>
                        <dt class="text-(--klyroo-text-muted)">Cells edited</dt>
                        <dd class="m-0 text-base font-bold tabular-nums text-(--klyroo-text-highlighted)">@Importer.AllRows.Count(r => r.Edited)</dd>
                    </div>
                </dl>
            }
            else
            {
                <div class="flex flex-col gap-3 rounded-(--klyroo-radius) border border-(--klyroo-border) p-4" data-slot="spreadsheet-progress">
                    <div class="flex items-center justify-between text-xs font-semibold">
                        <span>@(Importer.SubmitStatus == SpreadsheetSubmitStatus.Running ? "Importing…" : Importer.SubmitStatus == SpreadsheetSubmitStatus.Done ? $"{Importer.ImportedCount} rows imported" : "The import failed")</span>
                        <span class="tabular-nums text-(--klyroo-text-muted)">@($"{Importer.SubmitDone} of {Importer.SubmitTotal}")</span>
                    </div>

                    @if (Importer.RejectedCount > 0)
                    {
                        <div class="flex items-center justify-between gap-2 rounded bg-(--klyroo-error)/10 p-3 text-xs text-(--klyroo-error-text)"
                             data-slot="spreadsheet-rejected-box">
                            <span>Rows refused: @Importer.RejectedCount</span>
                            <div class="flex items-center gap-2">
                                <button type="button" class="font-semibold underline"
                                        data-slot="spreadsheet-retry-rejected"
                                        @onclick="Importer.RetryRejectedAsync">
                                    Send them again
                                </button>
                                <button type="button" class="font-semibold underline"
                                        data-slot="spreadsheet-see-rejected"
                                        @onclick="@(() => { Importer.SetReviewTab(SpreadsheetReviewTab.Invalid); Importer.GoToStep("review"); })">
                                    See them
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>;

    private void OnColumnSelectChange(string fieldKey, string? val)
    {
        if (string.IsNullOrEmpty(val)) Importer.IgnoreColumn(fieldKey);
        else if (int.TryParse(val, out var hIdx)) Importer.AssignColumn(fieldKey, hIdx);
    }

    private void OnValueAnswerChange(SpreadsheetValueQuestion q, string? raw)
    {
        if (string.IsNullOrEmpty(raw))
        {
            Importer.ClearAnswer(q.FieldKey, q.RawValue);
            return;
        }
        if (raw.StartsWith("map:", StringComparison.Ordinal))
        {
            var val = raw[4..];
            var opt = q.Choices.FirstOrDefault(c => c.Value == val);
            Importer.AnswerValue(q.FieldKey, q.RawValue, new SpreadsheetValueAnswer(SpreadsheetValueAnswerAction.Map, val, opt?.Label ?? val));
        }
        else if (raw == "action:create")
        {
            Importer.AnswerValue(q.FieldKey, q.RawValue, new SpreadsheetValueAnswer(SpreadsheetValueAnswerAction.Create));
        }
        else if (raw == "action:leave-empty")
        {
            Importer.AnswerValue(q.FieldKey, q.RawValue, new SpreadsheetValueAnswer(SpreadsheetValueAnswerAction.LeaveEmpty));
        }
        else if (raw == "action:skip-rows")
        {
            Importer.AnswerValue(q.FieldKey, q.RawValue, new SpreadsheetValueAnswer(SpreadsheetValueAnswerAction.SkipRows));
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _fileError = null;
        _loadingFile = true;
        try
        {
            var file = e.File;
            if (file.Size > MaxFileSize)
            {
                _fileError = $"The file is larger than {MaxFileSize / (1024 * 1024)} MB.";
                return;
            }
            await using var stream = file.OpenReadStream(MaxFileSize);
            await Importer.LoadFileAsync(stream, file.Name, MaxFileSize);
        }
        catch (Exception ex) when (ex is InvalidDataException or IOException)
        {
            _fileError = ex.Message;
        }
        finally
        {
            _loadingFile = false;
        }
    }

    private void LoadPastedRows()
    {
        if (string.IsNullOrWhiteSpace(_pastedText)) return;
        _fileError = null;
        Importer.Paste(_pastedText);
        _pastedText = "";
    }

    private void ReplaceFile()
    {
        _fileError = null;
        Importer.ClearFile();
    }

    private void OnHeaderRowChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var index))
        {
            Importer.SetHeaderRow(index);
        }
    }

    private void SelectVisibleRows(bool selected)
    {
        foreach (var row in Importer.VisibleReviewRows)
        {
            Importer.ToggleRowSelection(row.Index, selected);
        }
    }

    // The issues present in the rows, as filters for SetReviewIssueFilter ("fieldKey|code" or "|code" for row issues).
    private List<(string Filter, string Label, int Count)> IssueKinds()
    {
        var labels = Importer.Fields.ToDictionary(f => f.Column.Key, f => f.Column.EffectiveLabel, StringComparer.Ordinal);
        return Importer.AllRows
            .SelectMany(r => r.Issues.Select(i => (r.Index, i.Field, i.Code)))
            .GroupBy(x => (x.Field, x.Code))
            .Select(g => (
                Filter: $"{g.Key.Field}|{g.Key.Code}",
                Label: $"{(g.Key.Field is { } f && labels.TryGetValue(f, out var l) ? l : g.Key.Field ?? "Row")}: {g.Key.Code}",
                Count: g.Select(x => x.Index).Distinct().Count()))
            .OrderByDescending(x => x.Count)
            .ToList();
    }

    private void StartCellEdit(int rowIndex, string fieldKey, string currentText)
    {
        _editingCell = (rowIndex, fieldKey);
        _editingText = currentText;
    }

    private void CommitCellEdit(int rowIndex, string fieldKey)
    {
        if (_editingCell != (rowIndex, fieldKey)) return;
        _editingCell = null;
        Importer.EditCell(rowIndex, fieldKey, _editingText);
    }

    private void OnCellEditorKeyDown(KeyboardEventArgs e, int rowIndex, string fieldKey)
    {
        if (e.Key == "Escape")
        {
            _editingCell = null;
        }
        else if (e.Key is "Enter" or "Tab")
        {
            CommitCellEdit(rowIndex, fieldKey);
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnImporterChanged;
        }
    }
}
