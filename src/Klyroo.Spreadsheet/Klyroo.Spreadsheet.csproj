<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klyroo.Spreadsheet</RootNamespace>
    <PackageId>Klyroo.Spreadsheet</PackageId>
    <PackageTags>klyroo;blazor;csv;xlsx;xls;excel;import;data-import;maui</PackageTags>
    <Description>Klyroo Spreadsheet Import wizard, column/value mapping, inline review table and row inspector for Blazor Web &amp; .NET MAUI Hybrid.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);BL0007</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klyroo.Spreadsheet.Core\Klyroo.Spreadsheet.Core.csproj" />
    <ProjectReference Include="..\..\..\klyroo-ui\src\Klyroo.UI\Klyroo.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Klyroo.Spreadsheet.Tests" />
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="ios" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="maccatalyst" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Klyroo.UI" />
  </ItemGroup>
</Project>
